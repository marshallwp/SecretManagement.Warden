{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
		{
			"label": "sign-code",
			"type": "shell",
			"command": "$cert = Get-ChildItem -Path 'Cert:\\CurrentUser\\My' -CodeSigningCert; $files = Get-ChildItem ${workspaceFolder} -Filter '*.ps1' -Recurse; $files += Get-ChildItem ${workspaceFolder} -Filter '*.psm1' -Recurse; $files | Set-AuthenticodeSignature -Certificate $cert -TimestampServer 'http://timestamp.sectigo.com'",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": []
		}
	]
}
